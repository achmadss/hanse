[Unit]
Description=Hanse Gateway
Documentation=file:///usr/local/share/doc/hanse/docs/guides/systemd.md https://github.com/achmadss/hanse/blob/main/docs/guides/systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hanse
Group=hanse
ExecStart=/usr/local/bin/hanse-gateway --config /etc/hanse/gateway.yaml

# Treat a crash as a failure and start again, but never loop faster than
# every two seconds. A configuration problem exits 1 and is retried until an
# operator fixes the file, so journalctl holds the reported problems.
Restart=on-failure
RestartSec=2s

# The Gateway stops accepting requests and closes its stores on SIGTERM.
# Allow the configured grace period plus the store close to finish.
TimeoutStopSec=30s

# /var/lib/hanse holds the history and enrollment databases and is the only
# directory the service may write. /etc/hanse is read-only.
StateDirectory=hanse
StateDirectoryMode=0700
ConfigurationDirectory=hanse
UMask=0077

# Hardening. The Gateway needs no privilege: it listens on an unprivileged
# port and starts handler processes as its own user.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/hanse

[Install]
WantedBy=multi-user.target
